{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "ui_kits/app/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Aeonik Pro))/i]",
        "message": "Font not provided by the design system. Available: Inter, Aeonik Pro."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowUpRight'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|bold|size|key|ref|className|style|children)$/]",
        "message": "<ArrowUpRight> doesn't accept that prop. Declared props: className, style, bold, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowUpRight'] > JSXAttribute[name.name='bold'] > Literal[value!=/^(?:off|on)$/]",
        "message": "<ArrowUpRight> bold must be one of 'off' | 'on'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowUpRight'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ArrowUpRight> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|square|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, square."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|md|lg|xl)$/]",
        "message": "<Avatar> size must be one of 'xs' | 'sm' | 'md' | 'lg' | 'xl'."
      },
